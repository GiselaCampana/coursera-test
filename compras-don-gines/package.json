{
  "name": "compras-don-gines",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de compras para la cadena de fiambrerías Don Ginés",
  "scripts": {
    "dev": "node scripts/preparar-ocr.mjs && next dev -p 3000",
    "build": "node scripts/preparar-ocr.mjs && prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/preparar-e2e.mjs && playwright test",
    "test:all": "vitest run && node scripts/preparar-e2e.mjs && playwright test",
    "e2e:seed": "tsx tests/e2e/sembrar.ts",
    "e2e:server": "node scripts/servidor-e2e.mjs",
    "ocr:preparar": "node scripts/preparar-ocr.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@aws-sdk/s3-request-presigner": "^3.916.0",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tesseract.js-data/spa": "^1.0.0",
    "decimal.js": "^10.6.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "next": "^15.5.4",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
