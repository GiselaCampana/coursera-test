// Compras Don Ginés — modelo de datos
// Importes monetarios: Decimal(18,4). Tasas: Decimal(9,6). Pesos/cantidades: Decimal(14,4).
// Nunca usar Float para dinero.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Seguridad: usuarios, roles, sesiones
// ---------------------------------------------------------------------------

/// Roles configurables desde la aplicación. Los permisos son strings libres
/// (ver src/lib/auth/permissions.ts) para poder agregar roles nuevos —
/// supervisor, encargado, contador — sin tocar el código.
model Role {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  /// Lista de permisos otorgados. Ver PERMISSIONS en el código.
  permissions      String[]
  /// Si es true el rol ve todas las sucursales; si es false queda limitado a
  /// la sucursal asignada al usuario.
  scopeAllBranches Boolean  @default(false)
  /// Los roles de sistema no se pueden borrar (sí editar su nombre).
  isSystem         Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// Hash scrypt de la contraseña, o la marca "supabase-auth" cuando las
  /// contraseñas las guarda Supabase Auth. Ver src/lib/auth/proveedor.ts.
  passwordHash       String
  /// Id del usuario en Supabase Auth, cuando se usa ese proveedor.
  supabaseUserId     String?   @unique
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  /// Sucursal asignada. Obligatoria para roles sin scopeAllBranches.
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  documentsCreated   Document[]         @relation("DocumentCreatedBy")
  documentsValidated Document[]         @relation("DocumentValidatedBy")
  documentsVoided    Document[]         @relation("DocumentVoidedBy")
  paymentEvents      PaymentEvent[]
  auditLogs          AuditLog[]
  salePricesApproved SalePriceHistory[]
  archivosArchivados DocumentFile[]     @relation("ArchivosArchivados")

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 del token de sesión. El token en claro sólo vive en la cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Sucursales
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  documents         Document[]
  purchaseMovements PurchaseMovement[]
  costHistory       CostHistory[]
  salesMovements    SalesMovement[]

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Proveedores
// ---------------------------------------------------------------------------

enum TermType {
  SAME_DAY
  DAYS
  MANUAL
  /// Factura contra factura: se paga cuando llega la siguiente del proveedor.
  NEXT_INVOICE
}

model Supplier {
  id              String    @id @default(cuid())
  tradeName       String
  legalName       String?
  cuit            String?
  currency        String    @default("ARS")
  active          Boolean   @default(true)
  notes           String?
  /// Cuándo se espera la próxima factura o visita de este proveedor.
  ///
  /// Sólo tiene sentido con la condición "factura contra factura": sirve para
  /// poder agendar el pago de la factura de hoy mientras la siguiente todavía
  /// no llegó. Cuando llega, la fecha real reemplaza a la prevista.
  nextInvoiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  aliases           SupplierAlias[]
  paymentTerms      SupplierPaymentTerm[]
  taxRules          SupplierTaxRule[]
  documents         Document[]
  products          Product[]
  productAliases    ProductAlias[]
  purchaseMovements PurchaseMovement[]
  costHistory       CostHistory[]

  @@index([tradeName])
  @@map("suppliers")
}

/// Alias con los que el proveedor aparece impreso en los comprobantes.
model SupplierAlias {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  alias      String
  /// alias normalizado (sin acentos, mayúsculas, espacios colapsados)
  normalized String
  createdAt  DateTime @default(now())

  @@unique([supplierId, normalized])
  @@index([normalized])
  @@map("supplier_aliases")
}

/// Historial de condiciones de pago. Las facturas guardan una copia del plazo
/// vigente al momento de la carga (ver Document.appliedTermType).
model SupplierPaymentTerm {
  id            String    @id @default(cuid())
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  termType      TermType
  /// Cantidad de días cuando termType = DAYS.
  days          Int       @default(0)
  paymentMethod String    @default("TRANSFERENCIA")
  validFrom     DateTime
  validTo       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([supplierId, validFrom])
  @@map("supplier_payment_terms")
}

/// Historial de reglas impositivas por proveedor.
model SupplierTaxRule {
  id               String    @id @default(cuid())
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ivaRate          Decimal   @db.Decimal(9, 6)
  iibbRate         Decimal   @default(0) @db.Decimal(9, 6)
  /// Otras percepciones: [{ label, rate }]
  otherPerceptions Json      @default("[]")
  validFrom        DateTime
  validTo          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([supplierId, validFrom])
  @@map("supplier_tax_rules")
}

// ---------------------------------------------------------------------------
// Catálogo de productos
// ---------------------------------------------------------------------------

enum PurchaseUnit {
  KG
  UNIT
}

/// FETEABLE: se vende feteado (precio por 100 g, 1/4 kg y por pieza).
/// AL_CORTE: se vende al corte (precio por kilo y por horma).
enum SaleMode {
  FETEABLE
  AL_CORTE
}

enum MarginBasis {
  SOBRE_COSTO
  SOBRE_VENTA
}

/// Agrupación de artículos para consultar por rubro, no para identificarlos.
///
/// "Queso Sardo" es una familia; el Sardo Bloque Melincué y el Sardo Don Alfonso
/// son dos productos distintos, cada uno con su PLU, su costo y su precio. La
/// familia existe para poder preguntar cuánto Sardo se compró en total sin
/// perder de vista que son dos artículos: el reporte por familia suma todos los
/// PLU que cuelgan de ella, y el reporte por PLU sigue hablando de uno solo.
///
/// No reemplaza al PLU ni compite con él. Un producto puede no tener familia.
model ProductFamily {
  id         String   @id @default(cuid())
  /// Código de la familia en el catálogo de origen, si lo trae.
  code       String?  @unique
  name       String   @unique
  normalized String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Marcajes de la familia. Todos opcionales: los que quedan en null no dicen
  /// nada y el producto resuelve por su cuenta.
  ///
  /// Existen porque el marcaje casi nunca es una decisión por artículo: los
  /// quesos duros se marcan igual entre ellos, los fiambres cocidos también.
  /// Cargarlo treinta veces, una por PLU, es treinta oportunidades de que uno
  /// quede distinto sin que nadie se entere hasta que el precio sale mal.
  ///
  /// El producto siempre puede sobrescribirlos: la familia es el valor por
  /// omisión, no una imposición.
  targetMarginPct              Decimal?     @db.Decimal(9, 6)
  marginBasis                  MarginBasis?
  alCorteHormaDigitalMarginPct Decimal?     @db.Decimal(9, 6)
  alCorteHormaCashMarginPct    Decimal?     @db.Decimal(9, 6)
  alCorteCajaCashMarginPct     Decimal?     @db.Decimal(9, 6)
  feteado100gMarginPct         Decimal?     @db.Decimal(9, 6)
  feteadoQuarterMarginPct      Decimal?     @db.Decimal(9, 6)
  feteadoPieceDigitalMarginPct Decimal?     @db.Decimal(9, 6)
  feteadoPieceCashMarginPct    Decimal?     @db.Decimal(9, 6)
  wholeUnitMarginPct           Decimal?     @db.Decimal(9, 6)

  products Product[]

  @@index([normalized])
  @@map("product_families")
}

model Product {
  id                           String         @id @default(cuid())
  /// Código interno o PLU
  internalCode                 String         @unique
  normalizedName               String
  category                     String?
  /// Subtipo del catálogo de origen, cuando lo trae. Es informativo.
  subtype                      String?
  familyId                     String?
  family                       ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  /// Cuándo se actualizó por última vez desde el catálogo de Control de Stock.
  catalogSyncedAt              DateTime?
  purchaseUnit                 PurchaseUnit   @default(KG)
  saleMode                     SaleMode       @default(FETEABLE)
  /// Peso habitual de la pieza u horma, en kg.
  avgPieceWeightKg             Decimal?       @db.Decimal(14, 4)
  /// Peso neto, en kg, de una unidad de compra cuando el proveedor factura por
  /// unidad pero Don Ginés vende por kilo. Ej.: lata de dulce 5 kg, postre de
  /// maní 3 kg. Permite convertir costo por unidad -> costo por kilo.
  purchaseUnitWeightKg         Decimal?       @db.Decimal(14, 4)
  defaultSupplierId            String?
  defaultSupplier              Supplier?      @relation(fields: [defaultSupplierId], references: [id])
  /// Margen base por kilo, expresado como fracción (0.45 = 45 %).
  ///
  /// Opcional desde que existen los marcajes por familia: en null, el artículo
  /// toma el de su familia, y si la familia tampoco lo define, el 45 % general.
  /// Los artículos que ya estaban cargados conservan el suyo, así que dejarlo
  /// vacío es una decisión explícita de heredar y no un descuido.
  targetMarginPct              Decimal?       @db.Decimal(9, 6)
  marginBasis                  MarginBasis?
  /// Marcajes específicos por forma de venta. Si están en null usan el marcaje base.
  alCorteHormaDigitalMarginPct Decimal?       @db.Decimal(9, 6)
  alCorteHormaCashMarginPct    Decimal?       @db.Decimal(9, 6)
  alCorteCajaCashMarginPct     Decimal?       @db.Decimal(9, 6)
  feteado100gMarginPct         Decimal?       @db.Decimal(9, 6)
  feteadoQuarterMarginPct      Decimal?       @db.Decimal(9, 6)
  feteadoPieceDigitalMarginPct Decimal?       @db.Decimal(9, 6)
  feteadoPieceCashMarginPct    Decimal?       @db.Decimal(9, 6)
  /// Para artículos que se venden también por unidad completa (lata/cajón/postre).
  wholeUnitMarginPct           Decimal?       @db.Decimal(9, 6)
  /// Queda por compatibilidad histórica; los precios en efectivo ya no se calculan como descuento.
  cashDiscountPct              Decimal        @default(0) @db.Decimal(9, 6)
  /// Algunos artículos no usan PLU en la balanza y se identifican por código de barras.
  usesPlu                      Boolean        @default(true)
  barcode                      String?        @unique
  /// Regla de redondeo: NONE | NEAREST_10 | NEAREST_50 | NEAREST_100 | UP_100
  roundingRule                 String         @default("NEAREST_100")
  active                       Boolean        @default(true)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  aliases           ProductAlias[]
  documentItems     DocumentItem[]
  purchaseMovements PurchaseMovement[]
  costHistory       CostHistory[]
  pricingRules      PricingRule[]
  salePrices        SalePriceHistory[]
  salesMovements    SalesMovement[]

  @@index([normalizedName])
  @@index([familyId])
  @@map("products")
}

/// Cómo escribe cada proveedor a este producto. Se aprende de cada factura.
model ProductAlias {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Código con el que el proveedor identifica el artículo.
  supplierCode String?
  alias        String
  normalized   String
  /// AUTO cuando lo generó el matcher, MANUAL cuando lo confirmó un usuario.
  origin       String    @default("MANUAL")
  createdAt    DateTime  @default(now())

  @@unique([productId, supplierId, normalized])
  /// Un código de un proveedor apunta a **un** producto interno y a uno solo.
  ///
  /// Al revés sí: el mismo PLU puede tener un código distinto en cada proveedor
  /// —ART-00228 en Errecalde, 4587 en otro, CREM-PDA en un tercero— y todos
  /// apuntan al mismo artículo de Don Ginés. Lo que no puede pasar es que
  /// ART-00228 de Errecalde signifique dos cosas: ahí no hay forma de saber a
  /// cuál de los dos productos cargarle la compra.
  ///
  /// Postgres trata los nulos como distintos, así que esto no molesta a los
  /// alias que no tienen código: pueden convivir todos los que hagan falta.
  @@unique([supplierId, supplierCode])
  @@index([normalized])
  @@index([supplierId, supplierCode])
  @@map("product_aliases")
}

// ---------------------------------------------------------------------------
// Comprobantes
// ---------------------------------------------------------------------------

enum DocType {
  FACTURA
  REMITO
  /// Nota de crédito del proveedor. Resta en la cuenta corriente; que además
  /// mueva mercadería depende de cada renglón, no del tipo de comprobante.
  NOTA_CREDITO
}

/// Por qué el proveedor emitió la nota de crédito.
///
/// No es una etiqueta decorativa: separa las que sólo corrigen plata de la que
/// además implica mercadería que volvió. Con una sola categoría, "nota de
/// crédito" y "devolución" terminarían siendo lo mismo, y no lo son.
enum CreditReason {
  /// Bonificación por volumen, por pronto pago o acordada.
  BONIFICACION
  /// El precio facturado no era el pactado.
  DIFERENCIA_PRECIO
  /// Descuento comercial posterior a la factura.
  DESCUENTO_COMERCIAL
  /// Corrección de un error fiscal del comprobante original.
  CORRECCION_FISCAL
  /// Devolución de una percepción mal aplicada.
  DEVOLUCION_PERCEPCION
  /// Mercadería devuelta al proveedor.
  DEVOLUCION_MERCADERIA
  OTRO
}

/// De dónde sale un renglón del historial de costos.
///
/// El costo que originó una factura y el ajuste que le hizo después una nota de
/// crédito son dos hechos distintos y los dos tienen que quedar: pisar el
/// primero con el segundo haría desaparecer de dónde salió el costo vigente.
enum CostEntryKind {
  COMPRA
  AJUSTE_NC
}

enum DocumentStatus {
  /// Creado, todavía sin lectura.
  BORRADOR
  /// OCR en curso.
  PROCESANDO
  /// La lectura no cierra: requiere intervención. No se puede confirmar.
  REQUIERE_REVISION
  /// Controlado y guardado.
  VALIDADO
  /// Rechazado expresamente (libera la clave de duplicado).
  RECHAZADO
  /// Anulado por un administrador con motivo registrado.
  ANULADO
}

/// Semáforo del control contable.
enum CheckState {
  /// Verde: artículos, neto, impuestos y total controlados.
  OK
  /// Amarillo: hubo una corrección automática pero reconcilió.
  RECONCILIADO
  /// Rojo: el detalle no coincide. Bloquea el guardado.
  DIFERENCIA
  /// Todavía no se controló.
  PENDIENTE
}

model Document {
  id         String    @id @default(cuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// Razón social y CUIT tal como los leyó el OCR del papel.
  ///
  /// Se guardan aunque el proveedor no exista todavía —de hecho, sobre todo en
  /// ese caso—: sin esto, una factura de un proveedor desconocido llega a la
  /// pantalla de revisión sin ningún dato de quién la emitió, y el operador
  /// tiene que volver a mirar la foto para poder darlo de alta.
  readSupplierName String?
  readSupplierCuit String?

  docType DocType @default(FACTURA)
  /// Letra de la factura: A, B, C, M, X…
  letter  String?

  /// Motivo de la nota de crédito. Null en facturas y remitos.
  creditReason      CreditReason?
  /// La factura que esta nota de crédito corrige, cuando se sabe cuál es.
  ///
  /// Puede quedar en null a propósito: hay notas de crédito generales —una
  /// bonificación trimestral, una corrección de cuenta— que no corresponden a
  /// un comprobante en particular y se aplican al proveedor.
  relatedDocumentId String?
  relatedDocument   Document?     @relation("NotaDeCreditoDe", fields: [relatedDocumentId], references: [id], onDelete: SetNull)
  creditNotes       Document[]    @relation("NotaDeCreditoDe")
  pointOfSale       String        @default("")
  number            String        @default("")
  /// "0010-00212356"
  fullNumber        String        @default("")
  issueDate         DateTime?
  currency          String        @default("ARS")

  // Resumen impreso del comprobante
  grossSubtotal      Decimal? @db.Decimal(18, 4)
  discountTotal      Decimal? @db.Decimal(18, 4)
  netTotal           Decimal? @db.Decimal(18, 4)
  ivaTotal           Decimal? @db.Decimal(18, 4)
  perceptionsTotal   Decimal? @db.Decimal(18, 4)
  total              Decimal? @db.Decimal(18, 4)
  printedLineCount   Int?
  printedNetWeightKg Decimal? @db.Decimal(14, 4)
  printedTotalUnits  Decimal? @db.Decimal(14, 4)
  packageCount       Int?

  status      DocumentStatus @default(BORRADOR)
  checkState  CheckState     @default(PENDIENTE)
  /// Resultado detallado del validador (ver src/lib/domain/validation.ts).
  checkReport Json?

  // Copia de las condiciones vigentes al momento de la carga
  appliedTermType      TermType?
  appliedTermDays      Int?
  appliedPaymentMethod String?
  appliedIvaRate       Decimal?  @db.Decimal(9, 6)
  appliedIibbRate      Decimal?  @db.Decimal(9, 6)
  appliedDueDate       DateTime?

  /// Clave de deduplicación. Vale "ACTIVE" sólo mientras el comprobante está
  /// confirmado: ése es el que se queda con el número. Mientras es borrador
  /// lleva un valor propio (el default), así se puede leer una factura que ya
  /// existe y recién al confirmarla avisar del duplicado con un mensaje claro.
  /// Al anularla o rechazarla se reemplaza por su id, liberando el número.
  dedupeKey String @default(cuid())

  createdById   String
  createdBy     User      @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?     @relation("DocumentValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  /// Anulación administrativa: siempre exige motivo y queda en auditoría.
  voidReason String?
  voidedById String?
  voidedBy   User?     @relation("DocumentVoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files             DocumentFile[]
  ocrAttempts       OcrAttempt[]
  items             DocumentItem[]
  taxLines          DocumentTaxLine[]
  paymentSchedule   PaymentSchedule?
  purchaseMovements PurchaseMovement[]
  costHistory       CostHistory[]

  @@unique([supplierId, docType, pointOfSale, number, dedupeKey], name: "uniq_document_number")
  @@index([branchId, issueDate])
  @@index([supplierId, issueDate])
  @@index([status])
  @@index([relatedDocumentId])
  @@map("documents")
}

model DocumentFile {
  id                String    @id @default(cuid())
  documentId        String
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageOrder         Int
  /// Clave en el storage. Es la única versión que se guarda: la optimizada.
  storageKey        String
  mimeType          String
  /// Tipo del archivo tal como llegó del teléfono (HEIC, PNG…). El archivo en
  /// sí no se guarda: sólo el dato, para poder explicar qué se recibió.
  originalMimeType  String?
  sizeBytes         Int
  /// Cuánto pesaba al llegar, antes de optimizar.
  originalSizeBytes Int?
  /// SHA-256 del contenido original: evita cargar dos veces la misma foto.
  sha256            String
  width             Int?
  height            Int?
  createdAt         DateTime  @default(now())
  /// Cuándo se archivó la imagen para liberar espacio. Los datos extraídos del
  /// comprobante —artículos, costos, pagos— se conservan siempre; lo que se
  /// borra es la foto, y sólo después de exportarla.
  archivedAt        DateTime?
  /// Quién archivó la imagen.
  archivedById      String?
  archivedBy        User?     @relation("ArchivosArchivados", fields: [archivedById], references: [id])

  @@unique([documentId, sha256])
  @@index([documentId, pageOrder])
  @@map("document_files")
}

model OcrAttempt {
  id                String    @id @default(cuid())
  documentId        String
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  /// HEADER | ITEMS | SUMMARY | FULL | ITEMS_FOCUSED | SUMMARY_FOCUSED
  stage             String
  /// Descripción de la estrategia aplicada (recorte, contraste, zoom…).
  strategy          String?
  provider          String
  model             String?
  success           Boolean   @default(false)
  startedAt         DateTime
  finishedAt        DateTime?
  durationMs        Int?
  /// Respuesta cruda del proveedor, tal cual llegó.
  rawResponse       Json?
  recognizedText    String?
  overallConfidence Decimal?  @db.Decimal(5, 4)
  /// { campo: confianza }
  fieldConfidences  Json?
  error             String?
  /// Commit del código que produjo esta lectura, para saber si un resultado
  /// guardado viene de una versión anterior a un despliegue.
  buildSha          String?
  createdAt         DateTime  @default(now())

  @@index([documentId, attemptNumber])
  @@map("ocr_attempts")
}

enum TaxLineKind {
  IVA
  PERCEPCION
}

/// IVA discriminado por tasa y percepciones discriminadas por tipo.
model DocumentTaxLine {
  id         String      @id @default(cuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind       TaxLineKind
  label      String
  rate       Decimal     @db.Decimal(9, 6)
  base       Decimal?    @db.Decimal(18, 4)
  amount     Decimal     @db.Decimal(18, 4)

  @@index([documentId])
  @@map("document_tax_lines")
}

model DocumentItem {
  id               String       @id @default(cuid())
  documentId       String
  document         Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber       Int
  supplierCode     String?
  description      String
  quantity         Decimal      @db.Decimal(14, 4)
  unit             PurchaseUnit @default(KG)
  pieceCount       Int?
  totalWeightKg    Decimal?     @db.Decimal(14, 4)
  avgPieceWeightKg Decimal?     @db.Decimal(14, 4)

  unitNetPrice     Decimal @db.Decimal(18, 4)
  grossSubtotal    Decimal @db.Decimal(18, 4)
  /// true si el importe del renglón salió impreso del comprobante; false si se
  /// calculó como cantidad × precio. Un importe calculado no verifica nada.
  grossFromPrint   Boolean @default(true)
  discountPct      Decimal @default(0) @db.Decimal(9, 6)
  discountAmount   Decimal @default(0) @db.Decimal(18, 4)
  netAmount        Decimal @db.Decimal(18, 4)
  ivaRate          Decimal @default(0) @db.Decimal(9, 6)
  ivaAmount        Decimal @default(0) @db.Decimal(18, 4)
  perceptionAmount Decimal @default(0) @db.Decimal(18, 4)
  totalCost        Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  /// ¿Este renglón implicó mercadería que volvió al proveedor?
  ///
  /// Sólo tiene sentido en una nota de crédito, y se decide renglón por
  /// renglón: una misma nota puede corregir el precio de un artículo y
  /// documentar la devolución de otro. Por omisión es falso, que es la regla
  /// que importa: la existencia de una nota de crédito **no** implica que haya
  /// vuelto mercadería.
  stockReturn Boolean  @default(false)

  /// SUPPLIER_CODE | ALIAS | FUZZY | MANUAL | NONE
  matchMethod String   @default("NONE")
  matchScore  Decimal? @db.Decimal(5, 4)
  /// Confianza por campo devuelta por el OCR.
  confidence  Json?

  @@unique([documentId, lineNumber])
  @@index([productId])
  @@map("document_items")
}

// ---------------------------------------------------------------------------
// Pagos
// ---------------------------------------------------------------------------

enum PaymentStatus {
  AGENDADO
  VENCE_HOY
  VENCIDO
  PAGADO
  CANCELADO
}

model PaymentSchedule {
  id                   String        @id @default(cuid())
  documentId           String        @unique
  document             Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Fecha prevista. Nunca se pisa con la fecha efectiva.
  dueDate              DateTime
  /// ¿La fecha prevista es todavía una estimación?
  ///
  /// Sólo pasa con las condiciones "factura contra factura": el pago se hace
  /// cuando llega la próxima factura del proveedor, y hasta que llega lo único
  /// que hay es la fecha en que se la espera. Marcarlo permite mostrarla como
  /// provisoria y confirmarla después contra la fecha real, en vez de que
  /// conviva con las fechas firmes sin distinguirse.
  dueDateProvisional   Boolean       @default(false)
  plannedAmount        Decimal       @db.Decimal(18, 4)
  plannedPaymentMethod String
  /// Acumulado de pagos confirmados. Permite pagos parciales a futuro.
  paidAmount           Decimal       @default(0) @db.Decimal(18, 4)
  status               PaymentStatus @default(AGENDADO)
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  events PaymentEvent[]

  @@index([status, dueDate])
  @@index([dueDate])
  @@map("payment_schedules")
}

enum PaymentEventKind {
  CONFIRMACION
  CANCELACION
  REPROGRAMACION
}

model PaymentEvent {
  id            String           @id @default(cuid())
  scheduleId    String
  schedule      PaymentSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  kind          PaymentEventKind
  amount        Decimal?         @db.Decimal(18, 4)
  /// Fecha efectiva del pago (distinta de la prevista).
  effectiveDate DateTime?
  paymentMethod String?
  reference     String?
  notes         String?
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([scheduleId, createdAt])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Historial de compras y costos
// ---------------------------------------------------------------------------

/// Una fila por artículo comprado. Es la tabla de hechos para los reportes de
/// kilos, unidades e importes por producto / proveedor / sucursal / período.
model PurchaseMovement {
  id               String       @id @default(cuid())
  documentId       String
  document         Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentItemId   String       @unique
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id])
  supplierId       String?
  supplier         Supplier?    @relation(fields: [supplierId], references: [id])
  branchId         String
  branch           Branch       @relation(fields: [branchId], references: [id])
  date             DateTime
  description      String
  quantity         Decimal      @db.Decimal(14, 4)
  unit             PurchaseUnit
  pieceCount       Int?
  weightKg         Decimal?     @db.Decimal(14, 4)
  avgPieceWeightKg Decimal?     @db.Decimal(14, 4)
  unitNetPrice     Decimal      @db.Decimal(18, 4)
  discountAmount   Decimal      @db.Decimal(18, 4)
  netAmount        Decimal      @db.Decimal(18, 4)
  ivaAmount        Decimal      @db.Decimal(18, 4)
  perceptionAmount Decimal      @db.Decimal(18, 4)
  totalCost        Decimal      @db.Decimal(18, 4)
  unitCost         Decimal      @db.Decimal(18, 4)
  createdAt        DateTime     @default(now())

  @@index([productId, date])
  @@index([supplierId, date])
  @@index([branchId, date])
  @@index([date])
  @@map("purchase_movements")
}

/// Historial de costos unitarios finales, con el costo anterior para poder
/// calcular la variación sin recorrer toda la serie.
model CostHistory {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id])
  documentId       String?
  document         Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  date             DateTime
  /// Si este renglón es la compra que originó el costo o el ajuste que le hizo
  /// después una nota de crédito.
  kind             CostEntryKind @default(COMPRA)
  unitNetPrice     Decimal       @db.Decimal(18, 4)
  unitCost         Decimal       @db.Decimal(18, 4)
  previousUnitCost Decimal?      @db.Decimal(18, 4)
  /// unitCost - previousUnitCost
  deltaAmount      Decimal?      @db.Decimal(18, 4)
  /// Fracción: 0.12 = +12 %
  deltaPct         Decimal?      @db.Decimal(12, 6)
  createdAt        DateTime      @default(now())

  @@index([productId, date])
  @@map("cost_history")
}

// ---------------------------------------------------------------------------
// Precios de venta
// ---------------------------------------------------------------------------

/// Regla de formación de precios. Si productId es null es la regla general.
///
/// La regla general es el **tercer y último nivel** de la cadena de marcajes:
/// artículo → familia → regla general. Antes se consultaba y se descartaba —la
/// pantalla mostraba su nombre y ninguno de sus valores se aplicaba—, que es lo
/// peor de los dos mundos: prometía regir algo sin regirlo.
///
/// Es la única configuración global de marcajes. No hay ninguna otra en el
/// código: el valor por omisión del sistema vive en esta fila y se puede mirar.
model PricingRule {
  id              String      @id @default(cuid())
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  marginBasis     MarginBasis @default(SOBRE_COSTO)
  targetMarginPct Decimal     @db.Decimal(9, 6)

  /// Marcajes por forma de venta. En null, la forma de venta usa el base.
  alCorteHormaDigitalMarginPct Decimal? @db.Decimal(9, 6)
  alCorteHormaCashMarginPct    Decimal? @db.Decimal(9, 6)
  alCorteCajaCashMarginPct     Decimal? @db.Decimal(9, 6)
  feteado100gMarginPct         Decimal? @db.Decimal(9, 6)
  feteadoQuarterMarginPct      Decimal? @db.Decimal(9, 6)
  feteadoPieceDigitalMarginPct Decimal? @db.Decimal(9, 6)
  feteadoPieceCashMarginPct    Decimal? @db.Decimal(9, 6)
  wholeUnitMarginPct           Decimal? @db.Decimal(9, 6)

  /// Queda por compatibilidad; los precios en efectivo ya no se calculan como
  /// descuento sino con su propio marcaje.
  cashDiscountPct Decimal   @default(0) @db.Decimal(9, 6)
  /// Queda por compatibilidad. El redondeo lo fija la forma de venta y no se
  /// configura: kilo, 100 g y 1/4 al $100; horma, caja, pieza y unidad exactos.
  roundingRule    String    @default("NEAREST_100")
  validFrom       DateTime
  validTo         DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([productId, validFrom])
  @@map("pricing_rules")
}

model SalePriceHistory {
  id                   String      @id @default(cuid())
  productId            String
  product              Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Costo unitario final que originó el precio.
  costBasis            Decimal     @db.Decimal(18, 4)
  marginBasis          MarginBasis
  marginPct            Decimal     @db.Decimal(9, 6)
  suggestedPricePerKg  Decimal     @db.Decimal(18, 4)
  approvedPricePerKg   Decimal     @db.Decimal(18, 4)
  pricePer100g         Decimal     @db.Decimal(18, 4)
  pricePerQuarter      Decimal     @db.Decimal(18, 4)
  pricePerPieceDigital Decimal?    @db.Decimal(18, 4)
  pricePerPieceCash    Decimal?    @db.Decimal(18, 4)
  pieceWeightKg        Decimal?    @db.Decimal(14, 4)
  cashDiscountPct      Decimal     @db.Decimal(9, 6)
  validFrom            DateTime
  approvedById         String?
  approvedBy           User?       @relation(fields: [approvedById], references: [id])
  approvedAt           DateTime    @default(now())

  @@index([productId, validFrom])
  @@map("sale_price_history")
}

// ---------------------------------------------------------------------------
// Ventas (preparado para integrar Maxirest). No forma parte del MVP pero el
// modelo tiene que permitir la conciliación compra / venta / merma.
// ---------------------------------------------------------------------------

model SalesMovement {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id])
  date       DateTime
  quantity   Decimal      @db.Decimal(14, 4)
  unit       PurchaseUnit
  netAmount  Decimal      @db.Decimal(18, 4)
  /// Origen del dato: MAXIREST | MANUAL | OTRO
  source     String       @default("MANUAL")
  externalId String?
  createdAt  DateTime     @default(now())

  @@unique([source, externalId])
  @@index([productId, date])
  @@index([branchId, date])
  @@map("sales_movements")
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  /// Motivo, obligatorio en anulaciones administrativas.
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
