# ---------------------------------------------------------------------------
# Compras Don Ginés — variables de entorno
#
# Copiá este archivo a .env y completá los valores. El .env nunca se sube al
# repositorio: ninguna credencial vive en el código.
# ---------------------------------------------------------------------------

# --- Base de datos (obligatoria) -------------------------------------------
# PostgreSQL 14 o superior.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/compras_don_gines?schema=public"

# --- Aplicación -------------------------------------------------------------
NODE_ENV="development"
# URL pública desde la que se accede a la aplicación.
APP_URL="http://localhost:3000"

# --- Supabase: base, almacenamiento y (opcional) contraseñas ---------------
# Todo en un solo proyecto gratuito. Ver docs/DESPLIEGUE-RENDER-SUPABASE.md.
# SUPABASE_SERVICE_ROLE_KEY saltea todas las políticas de seguridad: va sólo en
# el servidor, nunca en una variable NEXT_PUBLIC_ ni en el repositorio.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Clave pública. En los proyectos nuevos se llama "publishable" y empieza con
# sb_publishable_; en los viejos era la "anon". Cualquiera de los dos nombres
# sirve.
SUPABASE_PUBLISHABLE_KEY=""
# Clave secreta: saltea todas las políticas de seguridad. En los proyectos
# nuevos empieza con sb_secret_; antes se llamaba service_role.
# Va SÓLO acá, del lado del servidor. Nunca en una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="comprobantes"

# Quién verifica las contraseñas: "local" (hash scrypt propio) o "supabase".
# Por defecto local, que es lo que usan las pruebas y el desarrollo.
AUTH_PROVIDER="local"

# Cuánto espacio se permite ocupar. 1 GB es lo que da el plan gratuito de
# Supabase; la aplicación avisa al 80 % y bloquea al 95 %, antes de que el
# proveedor rechace nada.
STORAGE_LIMIT_BYTES="1073741824"

# --- Almacenamiento de comprobantes ----------------------------------------
# "local" (disco), "supabase" (producción) o "s3".
# "local" guarda los archivos en disco (desarrollo o instalación chica con un
# volumen persistente). "s3" usa cualquier storage compatible con S3.
# "local" (disco), "supabase" (producción) o "s3".
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# Secreto con el que se firman las URLs de los comprobantes.
# OBLIGATORIO en producción. Generalo con:  openssl rand -base64 48
STORAGE_SIGNING_SECRET=""

# Vigencia de las URLs firmadas, en segundos.
SIGNED_URL_TTL_SECONDS="900"

# --- S3 (sólo si STORAGE_DRIVER="s3") --------------------------------------
# El bucket TIENE que ser privado: el acceso se da siempre por URL firmada.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Para MinIO, Cloudflare R2, Backblaze B2 y similares:
# S3_ENDPOINT="https://s3.tu-proveedor.com"
# S3_FORCE_PATH_STYLE="true"

# --- Lectura automática de comprobantes (OCR) ------------------------------
# La lectura corre entera en el teléfono con Tesseract, servido desde la propia
# aplicación. No hay clave de API que configurar ni costo por comprobante.
# Cuántas vueltas de relectura focalizada se permiten cuando el detalle no cierra.
OCR_MAX_ATTEMPTS="3"

# --- Identificación de la versión desplegada --------------------------------
# En Render no hace falta ninguna: la plataforma define RENDER_GIT_COMMIT y
# RENDER_GIT_BRANCH sola en cada despliegue, y son las que valen. Estas dos
# sirven para desplegar en otro lado; en desarrollo el dato sale de `git`.
# Se muestran en Más → Diagnóstico y en GET /api/version, que es la única forma
# de saber desde el teléfono qué versión está corriendo.
# APP_COMMIT=""
# APP_BRANCH=""

# --- Carga de archivos ------------------------------------------------------
MAX_FILES_PER_DOCUMENT="10"
MAX_UPLOAD_BYTES="26214400"

# --- Datos iniciales (sólo los usa `npm run db:seed`) ----------------------
# Si no se definen, el seed genera contraseñas al azar y las imprime una única
# vez por consola. Cambialas después del primer ingreso.
SEED_ADMIN_EMAIL="admin@donGines.local"
SEED_ADMIN_PASSWORD=""
SEED_OPERATOR_PASSWORD=""

# --- Integración con Control de Stock -------------------------------------
# La clave compartida con la que Control de Stock reconoce a Compras. Se carga
# en el panel de Render (y la misma en Control de Stock); nunca acá, nunca en
# el repositorio y nunca con prefijo NEXT_PUBLIC_.
#
# Se pega sola, sin "Bearer ": el pedido sale como
#   Authorization: Bearer <STOCK_INTEGRATION_KEY>
# y el prefijo lo pone el código. Sin esta variable la sincronización avisa que
# no está configurada y no sale a la red.
STOCK_INTEGRATION_KEY=""

# Casi nunca hace falta: por omisión es Authorization. Está por si Control de
# Stock cambia el encabezado, para poder seguirlo sin desplegar.
STOCK_INTEGRATION_HEADER=""

# Sólo para apuntar a un entorno de prueba. Vacío usa el endpoint de producción.
STOCK_CATALOG_URL=""
